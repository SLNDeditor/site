---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryAside from '../components/CategoryAside.astro';
import TheatreAside from '../components/TheatreAside.astro';
import PostHero from '../components/PostHero.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FootnotesTooltips from '../components/FootnotesTooltips.astro';
import { CATEGORY_LABEL, CURATED_ARTICLES, CURATED_VIDEOS, getCuratedPosts, getTheatreTree } from '../lib/categories';
import { renderInlineMarkdown } from '../lib/inline-markdown';
import { SITE_DESCRIPTION } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { id?: string };

const { title, description, lead, pubDate, showDate, updatedDate, heroImage, category, id, video, nada } =
	Astro.props;
// « description » = SEO seul (balise meta). « lead » = chapeau visible sous le
// titre, saisi en markdown restreint. Les deux sont indépendants : vider le
// chapeau ne doit plus effacer la description Google.
const leadHtml = await renderInlineMarkdown(lead);
// Filet de sécurité : plus jamais de <meta name="description" content="">.
// Si la description SEO est vide, on retombe sur le chapeau en texte brut,
// puis sur la description du site.
const metaDescription =
	description?.trim() ||
	leadHtml
		.replace(/<[^>]+>/g, ' ')
		.replace(/\s+/g, ' ')
		.trim()
		.slice(0, 160) ||
	SITE_DESCRIPTION;
// Quelle barre latérale ? Elle découle du champ « Rubrique » de l'admin, pas
// d'une liste de slugs tenue à la main : changer la rubrique d'un texte change
// aussitôt le menu de gauche qu'il affiche.
const isVideo = category === 'videos';
const videoPosts = isVideo ? await getCuratedPosts('videos', CURATED_VIDEOS) : [];
const isArticle = category === 'article';
const articlePosts = isArticle ? await getCuratedPosts('article', CURATED_ARTICLES) : [];
// Théâtre : barre latérale en arborescence (pièce + interventions + Guelma/Selma).
const isTheatre = category === 'theatre';
const theatreNodes = isTheatre ? await getTheatreTree() : null;
const hasAside = isVideo || isArticle || (category ? category in CATEGORY_LABEL : false);
---

<html lang="fr">
	<head>
		<BaseHead title={title} description={metaDescription} />
	</head>
	<body>
		<Header />
		<main class:list={['reader', { 'no-aside': !hasAside }]}>
			{
				isVideo ? (
					<CategoryAside title="Vidéos" posts={videoPosts} current={id} />
				) : isArticle ? (
					<CategoryAside title="Articles" posts={articlePosts} current={id} />
				) : isTheatre && theatreNodes ? (
					<TheatreAside nodes={theatreNodes} current={id} />
				) : (
					hasAside && category && <CategoryAside category={category} current={id} />
				)
			}

			<article class="reader-main">
				{
					video && (
						<div class="video-embed">
							<iframe
								src={`https://www.youtube-nocookie.com/embed/${video}`}
								title={title}
								loading="lazy"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								referrerpolicy="strict-origin-when-cross-origin"
								allowfullscreen
							/>
						</div>
					)
				}
				<header class="hero-slot">
					<PostHero post={{ data: Astro.props } as any} centered={!hasAside} />
				</header>

				<div class="prose">
					<slot />
				</div>

				<FootnotesTooltips />
			</article>
		</main>
		<Footer />

		<style>
			.reader {
				display: grid;
				grid-template-columns: 15rem 1fr;
				gap: 3.5rem;
				width: 100%;
				max-width: 70rem;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}
			.reader.no-aside {
				grid-template-columns: 1fr;
				max-width: 44rem;
			}

			/* Lecteur vidéo responsive 16:9 */
			.video-embed {
				position: relative;
				aspect-ratio: 16 / 9;
				width: 100%;
				margin-bottom: 2.5rem;
				background: #000;
			}
			.video-embed iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}
			.reader-main {
				min-width: 0;
			}

			/* Héro : couverture d'un côté, infos de l'autre.
			   Rendu par PostHero.astro (source unique) — ici on ne règle que
			   l'espace qui le sépare du corps du texte. */
			.hero-slot {
				display: block;
				margin-bottom: 3rem;
			}

			/* Lecture classique en scroll */
			.prose {
				max-width: 42rem;
				margin: 0 auto;
				hyphens: auto;
				-webkit-hyphens: auto;
			}
			.no-aside .prose {
				text-align: left;
			}

			@media (max-width: 860px) {
				.reader {
					grid-template-columns: 1fr;
					gap: 0;
					padding: 2rem 1.25rem;
				}
				.post-hero {
					grid-template-columns: 1fr;
					gap: 1.5rem;
					text-align: left;
				}
			}
		</style>
	</body>
</html>
