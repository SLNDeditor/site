---
import type { CollectionEntry } from 'astro:content';
import CategoryAside from './CategoryAside.astro';
import PostHero from './PostHero.astro';

interface Props {
	title: string;
	posts: CollectionEntry<'blog'>[];
	emptyText?: string;
}
const { title, posts, emptyText = 'Cette sélection sera bientôt alimentée.' } = Astro.props;
const featured = posts[0];
---

<main class="reader">
	<CategoryAside title={title} posts={posts} current={featured?.id} />

	<section class="reader-main">
		{
			featured ? (
				<article>
					<PostHero post={featured} href={`/blog/${featured.id}/`} />
				</article>
			) : (
				<div class="empty-cat">
					<h1>{title}</h1>
					<p>{emptyText}</p>
				</div>
			)
		}
	</section>
</main>

<style>
	.reader {
		display: grid;
		grid-template-columns: 15rem 1fr;
		gap: 3.5rem;
		width: 100%;
		max-width: 70rem;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}
	.reader-main { min-width: 0; }
	/* Le héro (couverture, date, titre, chapeau) est rendu par PostHero.astro. */
	.empty-cat { padding-top: 1rem; }

	@media (max-width: 860px) {
		.reader {
			grid-template-columns: 1fr;
			gap: 0;
			padding: 2rem 1.25rem;
		}
	}
</style>
