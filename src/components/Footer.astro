---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} — {SITE_TITLE}</p>
</footer>
<style>
	footer {
		padding: 3em 1em;
		border-top: 1px solid rgb(var(--line));
		color: rgb(var(--muted));
		text-align: center;
		font-family: var(--font-heading);
		font-size: 0.85rem;
		letter-spacing: 0.05em;
	}
	footer p { margin: 0; }
</style>
