---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import homeBg from '../assets/home-bg.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home">
		<Header />
		<section class="hero">
			<div class="hero-margin">
				<ul class="keywords">
					<li>Exil</li>
					<li>Colonisation</li>
					<li>Algérie</li>
					<li>Femmes</li>
					<li>Histoire</li>
					<li>Domination</li>
					<li>Kateb Yacine</li>
					<li>Théâtre</li>
					<li>Marc Garanger</li>
					<li>Photographies</li>
				</ul>
			</div>
			<Image
				src={homeBg}
				alt=""
				class="hero-image"
				widths={[700, 1100, 1600, 2200]}
				sizes="(max-width: 700px) 55vw, 75vw"
				loading="eager"
				fetchpriority="high"
			/>
		</section>

		<style>
			.hero {
				position: relative;
				height: calc(100vh - 3.6rem);
				height: calc(100dvh - 3.6rem);
				display: flex;
				align-items: stretch;
				overflow: hidden;
				background-color: #000;
			}
			.hero-margin {
				flex: 1 1 auto;
				min-width: 0;
				position: relative;
			}
			.hero-image {
				flex: 0 0 auto;
				height: 100%;
				width: auto;
				max-width: none;
				display: block;
				filter: grayscale(100%);
			}
			/* sous cette largeur, une image pleine hauteur déborderait et effacerait la marge : on la limite en largeur pour garder la marge et la liste visibles */
			@media (max-width: 700px) {
				.hero-image {
					height: auto;
					width: 55%;
					max-width: 55%;
					align-self: flex-start;
				}
			}
			/* ---------- mots-clés : liste en drapeau à droite, dans la marge noire ---------- */
			.keywords {
				position: absolute;
				top: 2rem;
				right: 15px;
				list-style: none;
				margin: 0;
				padding: 0;
				text-align: right;
			}
			.keywords li {
				font-family: var(--font-heading);
				color: #e0e0e0;
				font-size: clamp(0.85rem, 1.6vw, 1.05rem);
				letter-spacing: 0.03em;
				line-height: 1.9;
				white-space: nowrap;
			}
		</style>
	</body>
</html>
