---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CuratedReader from '../components/CuratedReader.astro';
import { getCuratedPosts, CURATED_ARTICLES } from '../lib/categories';
import { SITE_TITLE } from '../consts';

// Appartenance = champ « Rubrique » de l'admin ; CURATED_ARTICLES ne fixe que l'ordre.
const posts = await getCuratedPosts('article', CURATED_ARTICLES);
---

<html lang="fr">
	<head>
		<BaseHead title={`Articles — ${SITE_TITLE}`} description={`Articles de ${SITE_TITLE}.`} />
	</head>
	<body>
		<Header />
		<CuratedReader title="Articles" posts={posts} />
		<Footer />
	</body>
</html>
