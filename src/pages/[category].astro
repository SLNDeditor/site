---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryAside from '../components/CategoryAside.astro';
import TheatreAside from '../components/TheatreAside.astro';
import PostHero from '../components/PostHero.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FootnotesTooltips from '../components/FootnotesTooltips.astro';
import { CATEGORIES, CATEGORY_LABEL, getPostsByCategory, getTheatreTree, flattenTheatre } from '../lib/categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

export async function getStaticPaths() {
	return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const label = CATEGORY_LABEL[category] ?? category;

// Théâtre : barre latérale en arborescence (pièce « En Attendant l'algérie »
// puis « Guelma / Selma »). L'article mis en avant est le premier de l'arbre.
let featured;
let theatreNodes;
if (category === 'theatre') {
	theatreNodes = await getTheatreTree();
	const firstId = flattenTheatre(theatreNodes).find((n) => n.id)?.id;
	const all = await getCollection('blog');
	featured = all.find((p) => p.id === firstId);
} else {
	const posts = await getPostsByCategory(category);
	featured = posts[0];
}
const { Content } = featured ? await render(featured) : { Content: null };
// La page-rubrique affiche un vrai texte : sa description Google est celle de
// ce texte, pas un libellé fabriqué. (Avant : « Actualités — textes de … ».)
const metaDescription =
	featured?.data.description?.trim() || `${label} — textes de ${SITE_TITLE}.` || SITE_DESCRIPTION;
---

<html lang="fr">
	<head>
		<BaseHead title={`${label} — ${SITE_TITLE}`} description={metaDescription} />
	</head>
	<body>
		<Header />
		<main class="reader">
			{
				theatreNodes ? (
					<TheatreAside nodes={theatreNodes} current={featured?.id} />
				) : (
					<CategoryAside category={category} current={featured?.id} />
				)
			}

			<section class="reader-main">
				{
					featured ? (
						<>
							{featured.data.video && (
								<div class="video-embed">
									<iframe
										src={`https://www.youtube-nocookie.com/embed/${featured.data.video}`}
										title={featured.data.title}
										loading="lazy"
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
										referrerpolicy="strict-origin-when-cross-origin"
										allowfullscreen
									/>
								</div>
							)}
							<article>
								<PostHero post={featured} />
							</article>
							<div class="prose">
								<Content />
							</div>
							<FootnotesTooltips />
						</>
					) : (
						<div class="empty-cat">
							<h1>{label}</h1>
							<p>Cette rubrique sera bientôt alimentée.</p>
						</div>
					)
				}
			</section>
		</main>
		<Footer />

		<style>
			.reader {
				display: grid;
				grid-template-columns: 15rem 1fr;
				gap: 3.5rem;
				width: 100%;
				max-width: 70rem;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}
			.reader-main { min-width: 0; }
			/* Lecteur vidéo responsive 16:9 (même réglage que BlogPost.astro) */
			.video-embed {
				position: relative;
				aspect-ratio: 16 / 9;
				width: 100%;
				margin-bottom: 2.5rem;
				background: #000;
			}
			.video-embed iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}
			.prose {
				max-width: 42rem;
				margin: 2.5rem 0 0 0;
				hyphens: auto;
				-webkit-hyphens: auto;
			}
			.prose :global(audio) {
				width: 100%;
				margin: 1.5em 0;
			}
			.empty-cat { padding-top: 1rem; }

			@media (max-width: 860px) {
				.reader {
					grid-template-columns: 1fr;
					gap: 0;
					padding: 2rem 1.25rem;
				}
			}
		</style>
	</body>
</html>
